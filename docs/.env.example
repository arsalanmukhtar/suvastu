# =====================================================================
# SUVASTU environment
# Copy to .env at the repo root and fill in. Never commit .env.
# REQUIRED = must be filled before `make up`
# Only VITE_* variables reach the browser. Never put a secret in a VITE_* var.
# =====================================================================

# ---------- Project ----------
COMPOSE_PROJECT_NAME=suvastu
NODE_ENV=development
TZ=Asia/Karachi

# ---------- PostgreSQL / PostGIS ----------
POSTGRES_DB=suvastu
POSTGRES_USER=suvastu
# REQUIRED. Generate: openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ---------- API (Express) ----------
API_PORT=4000
# REQUIRED. Same user/password/db as above; host is the compose service "db".
# URL-encode special characters in the password.
DATABASE_URL=postgres://suvastu:<POSTGRES_PASSWORD>@db:5432/suvastu
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# ---------- Web (Vite + React + Mapbox) ----------
VITE_API_URL=/api
VITE_TILER_URL=http://localhost:8000
# REQUIRED. Mapbox PUBLIC token (starts with pk.), URL-restricted to your domains
VITE_MAPBOX_TOKEN=
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/satellite-streets-v12
# Host port for the web dev server (container stays on 5173)
WEB_PORT=5175
# true only if the repo lives on /mnt/c under WSL
CHOKIDAR_USEPOLLING=false

# ---------- Mapbox server-side (optional) ----------
# Secret token (starts with sk.), only for Uploads/Tilesets API. Never exposed to web.
MAPBOX_SECRET_TOKEN=
MAPBOX_USERNAME=

# ---------- NASA Earthdata (ASF search, downloads, HyP3, GES DISC) ----------
# REQUIRED
EARTHDATA_USERNAME=
# REQUIRED
EARTHDATA_PASSWORD=
# REQUIRED. User token from Earthdata profile > Generate Token (expires every 60 days)
EARTHDATA_TOKEN=

# ---------- Copernicus Data Space Ecosystem (recommended) ----------
CDSE_USERNAME=
CDSE_PASSWORD=

# ---------- Worker / processing ----------
DATA_DIR=/data
# Swat AOI bbox minx,miny,maxx,maxy (EPSG:4326)
AOI_BBOX=72.05,34.60,72.95,35.75
# Metric CRS for areas and buffers (UTM 43N)
METRIC_EPSG=32643
S1_START=2019-03-01
S1_END=2026-11-30
# Scenes with more 72h rainfall than this (mm, GPM IMERG) are flagged unusable
RAIN_FLAG_MM=40
# Starting thresholds for change alerts; calibrate on known sites
ALERT_DB_THRESHOLD=1.65
ALERT_COH_LOSS=0.35

# ---------- TiTiler ----------
TILER_PORT=8000
